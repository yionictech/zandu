# Copier en .env (jamais commité). En production, ces valeurs viennent du coffre de secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zandu:zandu@localhost:5432/zandu
# Secret HMAC des codes OTP et codes de remise : 32 caractères minimum, unique par environnement.
APP_SECRET=remplacer-par-une-longue-valeur-aleatoire-0000
# Agrégateur Mobile Money : « simulator » en local (interdit en production).
PAYMENT_PROVIDER=simulator
SIMULATOR_WEBHOOK_SECRET=dev-simulator-webhook-secret
# Numéro WhatsApp qui reçoit les alertes support (reversement en échec, paiement tardif…).
SUPPORT_ALERT_PHONE=
# Règles métier (valeurs par défaut du cahier des charges)
PAYMENT_TTL_MINUTES=10
CHECKOUT_MAX_MINUTES=30
PAYMENT_POLL_INTERVAL_SECONDS=120
PAYMENT_POLL_HORIZON_MINUTES=30
SELLER_ACCEPT_HOURS=24
DISPUTE_WINDOW_HOURS=48
# Attente chez le client avant que le livreur puisse le déclarer absent
RIDER_ABSENT_WAIT_MINUTES=10
NEW_SELLER_PAYOUT_CAP=150000
# Second facteur (TOTP) du personnel sur /v1/support et /v1/admin : toujours exigé en production
STAFF_MFA_REQUIRED=true
WORKER_TICK_SECONDS=5
# Adresse publique de l'API (liens du stockage de développement)
PUBLIC_API_URL=http://localhost:3000
# Origines web autorisées (CORS), séparées par des virgules ; vide = toutes (développement)
CORS_ORIGINS=
# Stockage des photos et pièces : « memory » en développement (avec dossier pour persister), « s3 » en recette et production
STORAGE_DRIVER=memory
LOCAL_STORAGE_DIR=.zandu-storage
# Pour essayer S3 en local : `docker compose up -d stockage`, `pnpm --filter @zandu/api storage:check`, puis
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=zandudev
# S3_SECRET_ACCESS_KEY=zandudevsecret
# S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_BASE_URL=http://localhost:8333/zandu-public
# Adresse du stockage vue des téléphones, si elle diffère de S3_ENDPOINT (réseau interne)
# S3_PUBLIC_ENDPOINT=
# Environnement de déploiement (recette, production) : voir deploy/recette et ADR-0013
# ZANDU_ENV=
