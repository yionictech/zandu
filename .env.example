# Copier en .env (jamais commité). En production, ces valeurs viennent du coffre de secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zandu:zandu@localhost:5432/zandu
# Secret HMAC des codes OTP et codes de remise : 32 caractères minimum, unique par environnement.
APP_SECRET=remplacer-par-une-longue-valeur-aleatoire-0000
# Agrégateur Mobile Money : « simulator » en local (interdit en production).
PAYMENT_PROVIDER=simulator
SIMULATOR_WEBHOOK_SECRET=dev-simulator-webhook-secret
# Numéro WhatsApp qui reçoit les alertes support (reversement en échec, paiement tardif…).
SUPPORT_ALERT_PHONE=
# Règles métier (valeurs par défaut du cahier des charges)
PAYMENT_TTL_MINUTES=10
CHECKOUT_MAX_MINUTES=30
PAYMENT_POLL_INTERVAL_SECONDS=120
PAYMENT_POLL_HORIZON_MINUTES=30
SELLER_ACCEPT_HOURS=24
DISPUTE_WINDOW_HOURS=48
NEW_SELLER_PAYOUT_CAP=150000
WORKER_TICK_SECONDS=5
