# Recette de Zandu — copier en .env sur le serveur (jamais dans git), puis remplir.
# Guide : docs/exploitation/mise-en-ligne-recette.md

# --- Adresses (les 4 enregistrements DNS pointent vers l'adresse IP du serveur) ---
SITE_HOST=recette.zandu.cg
API_HOST=api.recette.zandu.cg
BACKOFFICE_HOST=bo.recette.zandu.cg
MEDIA_HOST=media.recette.zandu.cg
# Avis d'expiration des certificats HTTPS (Let's Encrypt)
ACME_EMAIL=technique@zandu.cg

# --- Secrets : un tirage différent pour chacun, par exemple `openssl rand -hex 32` ---
POSTGRES_PASSWORD=
APP_SECRET=
SIMULATOR_WEBHOOK_SECRET=
# Mot de passe de la page des SMS de test (https://SITE_HOST/recette/sms), à donner aux testeurs
RECETTE_KEY=
# Clés du stockage objet : lettres et chiffres uniquement
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Facultatif ---
# Téléphone qui reçoit les alertes du support (format +242…)
SUPPORT_ALERT_PHONE=
# Back-office limité à ces adresses (séparées par des espaces), ex. « 41.202.0.0/16 ».
# Vide : ouvert, protégé par SMS + application d'authentification.
BACKOFFICE_ALLOWED_IPS=
# Notifications de l'application (ADR-0018, guide étape 7 bis) : « expo » pour les envoyer,
# « none » pour tout faire passer par la boîte des SMS de test.
PUSH_PROVIDER=none
# Jeton d'accès Expo, seulement si l'« envoi sécurisé » est activé sur le projet Expo
EXPO_ACCESS_TOKEN=
