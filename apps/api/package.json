{
  "name": "@zandu/api",
  "version": "0.1.0",
  "private": true,
  "description": "API backend de Zandu : monolithe modulaire (Fastify + PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=zandu-source src/main.ts",
    "dev:worker": "tsx watch --conditions=zandu-source src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=zandu-source src/db/migrate.ts",
    "db:seed": "tsx --conditions=zandu-source src/db/seed.ts",
    "user:grant-role": "tsx --conditions=zandu-source src/cli/grant-role.ts",
    "db:seed:demo": "tsx --conditions=zandu-source src/db/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@zandu/domain": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@zandu/api-client": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  }
}
