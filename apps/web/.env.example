# Adresse de l'API vue du serveur du site (jamais exposée au navigateur).
ZANDU_API_URL=http://localhost:3000
# Adresse publique du site : liens partagés, aperçus WhatsApp (Open Graph), plan du site.
SITE_URL=http://localhost:3200
# Développement : bouton « Simuler la validation du PIN » (simulateur d'agrégateur).
ZANDU_SIMULATOR=0
NEXT_TELEMETRY_DISABLED=1
# Tuiles de la carte « livreur en route » ({z}/{x}/{y}) : OpenStreetMap pour les essais,
# un fournisseur (MapTiler, Stadia…) en production (docs/ux/03 §15).
ZANDU_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ZANDU_MAP_ATTRIBUTION=© OpenStreetMap
