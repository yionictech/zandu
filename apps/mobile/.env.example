# Copier en .env. Adresse de l'API vue depuis le téléphone ou le navigateur :
#   web : http://localhost:3000 · émulateur Android : http://10.0.2.2:3000 · téléphone : http://<IP du poste>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Bouton « Simuler la validation du PIN » (simulateur d'agrégateur, jamais en production)
EXPO_PUBLIC_SIMULATOR=1
# Tuiles de la carte « livreur en route » (docs/ux/03 §15) : fournisseur en production.
EXPO_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap
