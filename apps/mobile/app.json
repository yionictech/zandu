{
  "expo": {
    "name": "Zandu",
    "slug": "zandu",
    "scheme": "zandu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "cg.zandu.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Zandu",
      "themeColor": "#C2410C"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Zandu utilise l'appareil photo pour photographier vos produits et vos pièces d'identité.",
          "photosPermission": "Zandu accède à vos photos pour illustrer vos produits.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2410C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pendant une course, Zandu partage votre position avec le client pour qu'il vous voie arriver. Rien n'est envoyé en dehors des courses.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
